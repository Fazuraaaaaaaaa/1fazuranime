# Upstream API (Sanka Vollerei - Otakudesu scraper API)
UPSTREAM_API_BASE=https://www.sankavollerei.web.id/anime
UPSTREAM_USER_AGENT=AniVerse/1.0 (Next.js streaming client)

# Outbound rate limit — keep BELOW the upstream 60 req/min hard cap.
# 3 violations = permanent API ban, so leave headroom.
RATE_LIMIT_PER_MIN=50

# Cache TTLs (seconds) — fresh window served from cache without upstream calls
CACHE_TTL_LIST=900      # 15 min: home / ongoing / completed / genre / schedule
CACHE_TTL_DETAIL=3600   # 60 min: anime detail (+ episode lists)
CACHE_TTL_EPISODE=1800  # 30 min: watch-page episode payload (stream tokens are short-lived)
CACHE_TTL_SEARCH=1800   # 30 min: search queries
CACHE_TTL_SERVER=300    # 5 min: resolved embed URLs (ephemeral tokens)

# Stale window multiplier: an entry older than ttl remains servable as
# stale-while-revalidate / 429-fallback for ttl * STALE_FACTOR (min 6h).
CACHE_STALE_FACTOR=6

NEXT_PUBLIC_APP_NAME=AniVerse
